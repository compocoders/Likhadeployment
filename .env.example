# ─── LMS Docker Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_strong_password

# ── Backend ───────────────────────────────────────────────────────────────────
# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=1d

# The URL your app will be publicly available at (used in CORS whitelist)
# Set to your Cloudflare Tunnel domain once configured, e.g.:
FRONTEND_URL=https://yourdomain.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port to expose Nginx on for local testing
FRONTEND_PORT=8080

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Get this token from: Zero Trust Dashboard → Networks → Tunnels → your tunnel → Configure
TUNNEL_TOKEN=paste_your_cloudflared_tunnel_token_here

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Code Execution (Judge0) ───────────────────────────────────────────────────
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_optional_for_low_traffic

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# ── Email (Resend — optional alternative) ────────────────────────────────────
RESEND_API_KEY=

# ── Email (SMTP — optional fallback) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
